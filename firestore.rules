rules_version = '2';

// Must match NEXT_PUBLIC_FIREBASE_ALLOWED_EMAIL (Firestore cannot read env vars).
function isAllowedCloudUser() {
  return request.auth != null
    && request.auth.token.email == 'mcskrobola@gmail.com';
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/conversations/{conversationId} {
      allow read, write: if isAllowedCloudUser()
        && request.auth.uid == userId;
    }
  }
}
