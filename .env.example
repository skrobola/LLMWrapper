# Site-wide password (required for deployed app)
SITE_PASSWORD=change-me-to-a-strong-password

# Secret for signing session cookies (min 16 characters)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Firebase (optional — enables cloud chat history)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
